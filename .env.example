# Google Cloud Service Account Credentials (either raw JSON string or base64-encoded)
GOOGLE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", ...}'

# Or path to credentials file (for local development)
# GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# Google Calendar ID:
# Use 'primary' if authenticated as the user or if your primary calendar is shared.
# Or use the specific Calendar ID (e.g., yourname@gmail.com or xxx@group.calendar.google.com)
CALENDAR_ID=your_email@gmail.com

# Optional popup notification reminder in minutes before contest start (default: 30)
REMINDER_MINUTES=30

# Optional secret for securing Vercel HTTP endpoint
# CRON_SECRET=your_custom_secure_secret
